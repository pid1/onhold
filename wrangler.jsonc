{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onhold",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],

  // A custom domain: Cloudflare creates the DNS record and certificate. Use
  // your own hostname on a zone in your account.
  "routes": [{ "pattern": "onhold.pid1.space", "custom_domain": true }],
  "workers_dev": false,

  // The agent's prompt, first message and config are read at runtime.
  "rules": [
    { "type": "Data", "globs": ["**/*.md", "**/*.txt", "**/*.json"], "fallthrough": true }
  ],

  "d1_databases": [
    // Filled in by `npx wrangler d1 create onhold`; replace it with yours.
    { "binding": "DB", "database_name": "onhold", "database_id": "c5fc3e4e-92c9-4e83-a147-f3ea2a6b8092", "migrations_dir": "migrations" }
  ],

  // One trigger, every 15 minutes: reconcile calls the webhooks missed, then
  // purge expired transcripts and drafts. One, because the free plan caps
  // cron triggers per account.
  "triggers": { "crons": ["*/15 * * * *"] },

  // Secrets are set with `npx wrangler secret put NAME`; see the env example file.
  "vars": { "PAUSED": "false", "ALLOWED_COUNTRY_CODES": "1" },

  "observability": { "enabled": true }
}
